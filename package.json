{
  "name": "eval-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:build": "tsc -p validation/tsconfig.json",
    "validate:goldset": "node validation/build-goldset.mjs",
    "validate:consistency": "node validation/consistency.mjs",
    "validate:agreement": "node validation/agreement.mjs",
    "validate:position": "node validation/position-bias.mjs",
    "validate": "npm run validate:build && npm run validate:consistency && npm run validate:agreement && npm run validate:position"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
